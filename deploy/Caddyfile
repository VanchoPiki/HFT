# SITE_ADDRESS: a host name gets automatic HTTPS (e.g. 203-0-113-7.sslip.io resolves to
# 203.0.113.7, no domain purchase needed); ":80" serves plain HTTP.
{$SITE_ADDRESS} {
	encode gzip

	# Reading is public. Anything that changes state or spends RPC quota needs a password.
	@write not method GET HEAD OPTIONS
	basic_auth @write {
		{$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
	}

	# Only the health probe of Spring's actuator is public.
	@actuator {
		path /actuator/*
		not path /actuator/health
	}
	respond @actuator 404

	reverse_proxy analytics:8080
}
