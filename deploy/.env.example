# Server secrets for deploy/docker-compose.yml. Copy to deploy/.env (git-ignored).

# RPC provider with WebSocket (the bot); empty = public endpoint, polling once a second
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Postgres password (internal network only); any long random string
DB_PASSWORD=change-me

# Public address. A host name gets HTTPS automatically: <ip-with-dashes>.sslip.io
SITE_ADDRESS=203-0-113-7.sslip.io

# Password for POST endpoints (discovery, history, backtest), bcrypt hash from:
#   docker run --rm caddy:2.10 caddy hash-password --plaintext 'your-password'
# Single quotes keep the $ signs of the hash literal.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH='$2a$14$replace.with.real.hash'
