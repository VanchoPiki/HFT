# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# RPC provider (Alchemy / QuickNode / Infura). WebSocket is required for subscriptions.
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Bot wallet. On anvil use one of its pre-funded test keys; no real keys before stage 9.
PRIVATE_KEY=
